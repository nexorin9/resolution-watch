# =============================================
# 院务会决议督办台账 — 环境变量样例
# 所有凭据仅放本文件 / 部署环境变量；切勿提交真实凭据
# =============================================

# ---- OA 出站 ----
# OA REST/SQL 的 bearer token；缺失则 cli 启动报错（退出码 1）
OA_API_BEARER=replace_me_with_real_bearer

# OA 查询端点描述
#  - HTTP 模式：https://oa.example.com/api/v1/events
#  - SQL 模式：postgres://user:pass@host:5432/oa
OA_QUERY_DSN=replace_me_with_oa_endpoint

# ---- 本地存储 ----
# Sqlite 文件路径，默认 ./.reso_cache.sqlite
RESO_DB_PATH=./.reso_cache.sqlite

# 会议纪要落地点（inbox/<week_id>/minutes.md）
RESO_MINUTES_DIR=./inbox

# 导出包输出目录（out/<week_id>/ 下含 6 文件）
OUT_DIR=./out

# ---- LLM（OpenAI-compatible 单一协议）----
MODEL_BASE_URL=https://api.example.com/v1
MODEL_API_KEY=replace_me_with_real_key
MODEL_NAME=gpt-4o-mini
# 超时（毫秒），默认 15000
MODEL_TIMEOUT_MS=15000

# ---- 通知（可选）----
WECOM_WEBHOOK_URL=
